# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Used when running the app outside Docker (npm run dev). Docker Compose sets its own.
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5433/helpdesk
PORT=3000
# Optional: override the model
# CLAUDE_MODEL=claude-opus-5-5
# Optional: enables the tickets page at /admin.html (send it as a Bearer token)
# ADMIN_TOKEN=
