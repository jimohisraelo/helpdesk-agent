# Copy to .env and fill in. Never commit .env.

# Set ONE of these. If both are set, OpenAI is used unless LLM_PROVIDER says otherwise.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider ("openai" or "anthropic")
# LLM_PROVIDER=openai

# Optional: override the models
# OPENAI_MODEL=gpt-5-mini
# CLAUDE_MODEL=claude-opus-5-5

# Used when running the app outside Docker (npm run dev). Docker Compose sets its own.
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5433/helpdesk
PORT=3000

# Optional: enables the tickets page at /admin.html (send it as a Bearer token)
# ADMIN_TOKEN=
